#include <iostream>
#include <string>
#include <limits>

using namespace std;

int main() {
    // 初始化变量
    int a = 10;
    string name = "C++学习第1天";

    cout << "Hello World!" << endl;
    cout << "Initialized a: " << a << "  Theme: " << name << endl;

    // 读取整数并进行输入验证
    cout << "Please enter an integer: ";
    while (!(cin >> a)) {
        cout << "输入无效，请输入一个整数：";
        cin.clear();
        cin.ignore(numeric_limits<streamsize>::max(), '\n');
    }

    cout << "You entered: " << a << endl;

    // Wait for Enter before exit
    cout << "Press Enter to exit...";
    cin.ignore(numeric_limits<streamsize>::max(), '\n');
    cin.get();

    return 0;
}
